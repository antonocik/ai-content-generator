# local (default): no credentials needed, uses the offline template provider
ACG_PROVIDER=local

# openai (or any OpenAI-compatible endpoint via ACG_BASE_URL)
# ACG_PROVIDER=openai
# ACG_API_KEY=sk-...
# ACG_MODEL=gpt-4o-mini
# ACG_BASE_URL=https://api.openai.com/v1

# anthropic
# ACG_PROVIDER=anthropic
# ACG_API_KEY=sk-ant-...
# ACG_MODEL=claude-3-5-haiku-latest

ACG_TEMPERATURE=0.7
ACG_MAX_TOKENS=1024
ACG_CORS_ORIGINS=*
